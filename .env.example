# 网络：默认监听全部网卡，端口 9900。
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9900

# SQLite 数据文件（相对项目根目录）。
GATEWAY_DB_PATH=data/chatgpt_gateway.db
GATEWAY_WORKER_ENABLED=true
GATEWAY_POLL_INTERVAL_SECONDS=0.5
GATEWAY_TASK_TIMEOUT_SECONDS=300
GATEWAY_STALE_TASK_SECONDS=360

# provider 可选：openbrowser（默认）或 demo（仅本地验证）。
GATEWAY_PROVIDER=openbrowser
# OpenBrowser 驱动命令。网关会向其 stdin 写入 JSON，要求 stdout 返回
# {"answer":"...", "conversation_url":"...", "message_id":"..."}。
# 例如：GATEWAY_OPENBROWSER_COMMAND=python path/to/openbrowser_driver.py
GATEWAY_OPENBROWSER_COMMAND=
