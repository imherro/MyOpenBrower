# 网络：默认监听全部网卡，端口 9900。
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9900

# SQLite 数据文件（相对项目根目录）。
GATEWAY_DB_PATH=data/chatgpt_gateway.db
GATEWAY_WORKER_ENABLED=true
GATEWAY_POLL_INTERVAL_SECONDS=0.5
GATEWAY_TASK_TIMEOUT_SECONDS=300
GATEWAY_STALE_TASK_SECONDS=360

# provider 可选：openbrowser（默认，使用 Playwright 驱动隔离的 Chrome Profile）、command 或 demo（仅本地验证）。
GATEWAY_PROVIDER=openbrowser
# 可选：当 provider=command 时使用。网关会向其 stdin 写入 JSON，要求 stdout 返回
# {"answer":"...", "conversation_url":"...", "message_id":"..."}。
# 例如：GATEWAY_OPENBROWSER_COMMAND=python path/to/custom_driver.py
GATEWAY_OPENBROWSER_COMMAND=
GATEWAY_CHATGPT_BASE_URL=https://chatgpt.com/
GATEWAY_BROWSER_PROFILES_DIR=profiles
GATEWAY_BROWSER_HEADLESS=false
# GATEWAY_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe

# 可选：配置后所有 /api/ 请求须包含 X-API-Key。
# GATEWAY_API_KEY=replace-with-a-long-random-secret
